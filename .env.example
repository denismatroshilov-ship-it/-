# Telegram
TG_BOT_TOKEN=123456:AA...
# Канал, куда уходят превью на аппрув и финальные посты. Бот должен быть админом.
TG_CHANNEL_ID=-1001234567890
# Кто имеет право жать кнопки аппрува (через запятую, user id)
TG_ADMIN_IDS=11111111

# Higgsfield
HIGGSFIELD_API_KEY=hf_...
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# id подключённого TikTok-аккаунта (см. `python -m app.cli tiktok-accounts`)
TIKTOK_ACCOUNT_ID=

# Пайплайн
VIDEO_MODEL=higgsfield-video-1
VIDEO_ASPECT_RATIO=9:16
VIDEO_DURATION_SEC=10
# Cron публикации отложенной очереди (UTC)
PUBLISH_CRON=0 9,15,20 * * *
# Сколько роликов выпускать за один тик расписания
PUBLISH_BATCH=1
# Публиковать без ручного аппрува
AUTO_APPROVE=false

DB_PATH=./data/queue.db
LOG_LEVEL=INFO

# Нарезка
SOURCES_DIR=./sources
CLIPS_DIR=./data/clips
