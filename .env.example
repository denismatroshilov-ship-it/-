# Telegram
TG_BOT_TOKEN=123456:AA...
# Куда слать превью на аппрув. Пусто = в личку первому админу
# (нужно один раз нажать /start у бота). Можно id приватного канала (-100…).
TG_REVIEW_CHAT=
# Кто имеет право жать кнопки аппрува (через запятую, user id)
TG_ADMIN_IDS=11111111

# Higgsfield
HIGGSFIELD_API_KEY=hf_...
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# connector_id подключённого TikTok-аккаунта (см. команду /accounts)
TIKTOK_ACCOUNT_ID=d9862749-1d2a-4ca2-a401-3422e7493757

# Пайплайн
# Cron публикации отложенной очереди (UTC)
PUBLISH_CRON=0 9,15,20 * * *
# Сколько роликов выпускать за один тик расписания
PUBLISH_BATCH=1
# Публиковать без ручного аппрува
AUTO_APPROVE=false

# HTTP-API для iOS-приложения «Hermes». Пусто = API выключен.
# Придумай длинный случайный токен и вбей тот же в приложении на айфоне:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_API_TOKEN=
HERMES_API_HOST=0.0.0.0
HERMES_API_PORT=8000

DB_PATH=./data/queue.db
LOG_LEVEL=INFO

# Нарезка
SOURCES_DIR=./sources
CLIPS_DIR=./data/clips
